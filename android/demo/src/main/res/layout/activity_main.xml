<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/identifyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/identify" />

        <Button
            android:id="@+id/identifyV2Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/identify_v2"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/claimRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        style="?android:attr/buttonBarStyle">

        <EditText
            android:id="@+id/roundInput"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/round_hint"
            android:inputType="text"
            android:text="@string/round_default" />

        <Button
            android:id="@+id/claimButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:enabled="false"
            android:text="@string/claim_test" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/idle"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
