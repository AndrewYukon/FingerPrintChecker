    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
