{
  "name": "@fingerprintchecker/react-native",
  "version": "0.1.1",
  "description": "React Native wrapper for the FingerPrintChecker native SDK (identify flow).",
  "license": "Apache-2.0",
  "main": "lib/commonjs/index.js",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "lib",
    "android",
    "ios",
    "*.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!android/build",
    "!android/.gradle",
    "!android/src/test",
    "!android/src/androidTest",
    "!**/.DS_Store"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
