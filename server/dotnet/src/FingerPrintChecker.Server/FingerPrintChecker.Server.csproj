<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>FingerPrintChecker.Server</PackageId>
    <Version>0.1.0</Version>
    <Description>Server SDK for the FingerPrintChecker API: client, sealed results, webhook verification, bot check.</Description>
    <Authors>FingerPrintChecker</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/AndrewYukon/FingerPrintChecker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AndrewYukon/FingerPrintChecker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fingerprint;fraud;bot-detection;webhook</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FingerPrintChecker.Server.Tests" />
  </ItemGroup>

</Project>
