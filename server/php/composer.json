{
    "name": "fpchecker/fpchecker-php",
    "description": "Server SDK for the FpChecker API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "FpChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FpChecker\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
